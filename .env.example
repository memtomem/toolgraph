# Copy to .env and adjust. Matches docker-compose.yml defaults.
# Existing/shared deployment backend. New local projects can instead run
# `toolgraph init`, which writes a Ladybug config under .toolgraph/.
# Use one or the other in a directory: if this disagrees with
# .toolgraph/config.json, commands refuse to run until you pass --config or
# remove the variable.
TOOLGRAPH_BACKEND=neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
# Local throwaway credential, not a secret. docker-compose.yml reads this same
# variable, so changing it here keeps the database and the client in sync.
# Use a real secret manager for any shared or non-loopback deployment.
NEO4J_PASSWORD=toolgraph-dev
NEO4J_DATABASE=neo4j
# TOOLGRAPH_DB_PATH=.toolgraph/toolgraph.lbug

# Inputs used when `crawl --servers` / `ingest-manifest --governance` is
# omitted, relative to the directory you run toolgraph from. The values shown
# are the built-in defaults. The repository root has no such files: pass the
# examples explicitly (`--servers examples/servers.yaml`). Pointing these at
# examples/ would make a bare `crawl` reconcile your graph against the example
# fleet and retire every other server.
# TOOLGRAPH_SERVERS=servers.yaml
# TOOLGRAPH_GOVERNANCE=governance.yaml
